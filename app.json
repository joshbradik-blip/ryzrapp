{
  "cli": {
    "appVersionSource": "app.json"
  },
  "expo": {
    "name": "RYZR",
    "slug": "ryzrapp",
    "version": "1.0.10",
    "scheme": "ryzr",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/b0b5de98-cbf0-4c33-8080-5726cd0708d2"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ryzr.app",
      "buildNumber": "22",
      "infoPlist": {
        "NSCameraUsageDescription": "RYZR uses your camera to analyze your workout form in real-time.",
        "NSMicrophoneUsageDescription": "RYZR uses audio for voice coaching feedback.",
        "NSPhotoLibraryUsageDescription": "RYZR can save workout clips to your photo library.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ryzr.app",
      "versionCode": 22,
      "minSdkVersion": 28,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_LEAN_BODY_MASS",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_EXERCISE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withPrismSDK",
      "./plugins/withAdiRegistration",
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "RYZR uses your camera to analyze your workout form in real-time."
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "RYZR uses your camera to analyze your workout form in real-time.",
          "enableMicrophonePermission": false,
          "enableLocation": false,
          "enableFrameProcessors": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#00FF88"
        }
      ],
      "expo-web-browser",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "RYZR reads your steps, activity, sleep, heart-rate, and body-composition data to personalize your training and track your progress.",
          "NSHealthUpdateUsageDescription": "RYZR only reads data from Apple Health; it does not write or modify any Health data.",
          "background": false
        }
      ],
      "react-native-health-connect"
    ],
    "extra": {
      "eas": {
        "projectId": "b0b5de98-cbf0-4c33-8080-5726cd0708d2"
      }
    }
  }
}
