# Supabase — get these from your project at supabase.com > Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Anthropic — key is stored as a Supabase Edge Function secret (ANTHROPIC_KEY).
# Do NOT add it here — all Claude API calls go through the anthropic-proxy edge function.

# ExerciseDB — rapidapi.com > ExerciseDB by Justin-Theophile > Subscribe (free tier)
EXPO_PUBLIC_EXERCISEDB_KEY=your_rapidapi_key_here

# Google AI (Gemini / Imagen / Veo) — OPTIONAL, for local media-generation scripts only.
# NOT used by the app. Plain var (NO "EXPO_PUBLIC_" prefix) so it never gets bundled
# into the client. Get one at aistudio.google.com > Get API key.
GEMINI_API_KEY=your_google_ai_studio_key_here

# Meta (Facebook/Instagram) app-events SDK — OPTIONAL, powers install/purchase
# tracking for Meta Ads Manager campaigns. Get these from developers.facebook.com
# > your app > Settings > Basic (App ID) and > Advanced > Security (Client Token).
# Both values are designed by Meta to ship inside the client binary — not secrets.
# Also set these as EAS project environment variables so `eas build` picks them up.
EXPO_PUBLIC_FACEBOOK_APP_ID=your_meta_app_id_here
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=your_meta_client_token_here
